# Copy to .env and fill in. .env is git-ignored and never baked into images.

# --- DagsHub / MLflow (Task 3.2) ---
MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub-user>/24L-0672_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-user>
MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>

# --- Web app (Tasks 4-5) ---
FLASK_SECRET_KEY=change-me-to-a-long-random-string
MODEL_PATH=models/champion.keras
# leave empty to use the threshold chosen on validation data (stored in champion.json)
THRESHOLD=
MAX_UPLOAD_MB=8
# local = load the Keras model inside Flask; remote = call the cloud model API
INFERENCE_BACKEND=local
MODEL_API_URL=https://<hf-user>-24l-0672-a2-ops.hf.space
MODEL_API_KEY=change-me-shared-secret

# --- Database (Task 5 / 6.3) ---
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=visionguard
# Outside Docker you can use SQLite instead:
# DATABASE_URL=sqlite:///instance/visionguard.db
DATABASE_URL=postgresql+psycopg2://visionguard:change-me-db-password@db:5432/visionguard
