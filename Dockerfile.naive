# "BEFORE" image for Task 6.4 - intentionally unoptimised, used only to compare sizes.
# Full python base, full tensorflow package, pip cache kept, single stage, runs as root.
# Build: docker build -f Dockerfile.naive -t 24l-0672_a2_ops-web:naive .
FROM python:3.11
WORKDIR /app
COPY . .
RUN sed 's/tensorflow-cpu/tensorflow/' requirements-serve.txt > /tmp/req.txt && pip install -r /tmp/req.txt
CMD ["gunicorn", "-c", "gunicorn.conf.py", "visionguard.web.wsgi:app"]
